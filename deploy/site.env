# Site configuration of this deployment - no secrets (those live in secrets.env on the server).
# A fork changes these values, its theme and nothing else.
PRESSERL_HOSTNAME=presserl.unterrainer.info
PRESSERL_OIDC_ISSUER=https://auth.unterrainer.info/realms/presserl
PRESSERL_OIDC_ADMIN_CLIENT_ID=presserl-admin
# Unique Traefik router/service name and compose project name on the host
PRESSERL_ROUTER=presserl
# Optional Traefik rule when more than PRESSERL_HOSTNAME is served; single quotes keep the backticks, e.g.
# PRESSERL_ROUTER_RULE='Host(`example.org`) || Host(`www.example.org`)'
# Traefik entrypoints on babylon5: web,websecure = LAN/VPN; a public site lists
# web,websecure,web-ext,websecure-ext. Staging is public all the same: Traefik's rules.yml on the
# host routes it from outside (Google Play reviewers use it), not these labels.
PRESSERL_ENTRYPOINTS=web,websecure
# Host directory for the PostgreSQL data (backup-critical)
PRESSERL_DB_DIR=/app/data/presserl/postgres
PRESSERL_NEWSPAPER_NAME="Presserl Staging"
# Spell check language (LanguageTool code); Austrian German accepts Jänner and heuer
PRESSERL_SPELL_CHECK_LANGUAGE=de-AT
